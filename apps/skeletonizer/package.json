{
  "name": "skeletonizer",
  "version": "0.3.0",
  "description": "Web skeleton screens from your real DOM + mock data + pure CSS. 运行时 + mock + 覆盖标记的 Web 骨架屏。",
  "keywords": [
    "css",
    "loading",
    "placeholder",
    "react",
    "skeleton",
    "skeleton-screen",
    "solid",
    "svelte",
    "vue",
    "web-component",
    "骨架屏"
  ],
  "homepage": "https://github.com/icodejoo/codejoo/tree/main/apps/skeletonizer#readme",
  "bugs": {
    "url": "https://github.com/icodejoo/codejoo/issues"
  },
  "license": "MIT",
  "author": "icodejoo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icodejoo/codejoo.git",
    "directory": "apps/skeletonizer"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "llms.md",
    "web-types.json",
    "html-custom-data.json"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./src/core/index.ts",
    "./src/full/index.ts",
    "./src/full/variants/*.ts",
    "./dist/full.mjs",
    "./dist/lite.mjs"
  ],
  "main": "./dist/full.mjs",
  "module": "./dist/full.mjs",
  "types": "./dist/full.d.mts",
  "exports": {
    ".": {
      "types": "./dist/full.d.mts",
      "import": "./dist/full.mjs",
      "default": "./dist/full.mjs"
    },
    "./lite": {
      "types": "./dist/lite.d.mts",
      "import": "./dist/lite.mjs",
      "default": "./dist/lite.mjs"
    },
    "./vue": {
      "types": "./dist/vue.d.mts",
      "import": "./dist/vue.mjs",
      "default": "./dist/vue.mjs"
    },
    "./react": {
      "types": "./dist/react.d.mts",
      "import": "./dist/react.mjs",
      "default": "./dist/react.mjs"
    },
    "./svelte": {
      "types": "./dist/svelte.d.mts",
      "import": "./dist/svelte.mjs",
      "default": "./dist/svelte.mjs"
    },
    "./solid": {
      "types": "./dist/solid.d.mts",
      "import": "./dist/solid.mjs",
      "default": "./dist/solid.mjs"
    },
    "./element": {
      "types": "./dist/element.d.mts",
      "import": "./dist/element.mjs",
      "default": "./dist/element.mjs"
    },
    "./full.css": "./dist/full.css",
    "./lite.css": "./dist/lite.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "fmt": "vp fmt -c oxfmt.config.ts",
    "lint": "vp lint -c oxlint.config.ts",
    "check": "vp fmt -c oxfmt.config.ts --check && vp lint -c oxlint.config.ts",
    "gen:editor": "node scripts/gen-editor-data.mjs",
    "build": "node scripts/gen-editor-data.mjs && vp pack",
    "build:demo": "node scripts/build-demo.mjs",
    "dev": "vp dev",
    "dev:lib": "vp pack --watch",
    "test": "vp test",
    "prepublishOnly": "pnpm run check && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@tsdown/css": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "^19.0.0",
    "@typescript/native-preview": "catalog:",
    "react": "^19.0.0",
    "sass": "^1.105.1",
    "solid-js": "^1.9.0",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "solid-js": ">=1.6.0",
    "vue": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "web-types": "./web-types.json"
}
